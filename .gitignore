# Working documents, not part of the toolkit
AUDIT-*.md
RELEASE_NOTES.txt
COMMITMSG.txt

# Backups left by editors and by cowork_util byte-replace
*.bak
*.bak.*

# Release artefacts
*.zip

# Anything the scripts themselves produce, in case someone runs them from a
# clone rather than from an install
fix-logs/
watch-logs/
vhdx-backup/
claude-env.json
watch-state.json

# Stub launchers written by .ci/Test-BatExitCodes.ps1. They live in the repo
# root rather than %TEMP% because every launcher checks for its .ps1 next to
# itself. They are removed in a finally block, so one surviving here means a
# test run was interrupted.
_battest_*
